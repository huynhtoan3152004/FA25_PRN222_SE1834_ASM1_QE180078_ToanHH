<!-- Simple SignalR Script -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
<script>
$(document).ready(function () {
    // Khởi tạo SignalR
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/DealerHub")
        .build();

    connection.start()
        .then(function () {
            console.log("✅ SignalR Connected");
        })
        .catch(function (err) {
            console.error("❌ SignalR failed:", err);
            alert("SignalR connection failed: " + err);
        });

    // Xử lý nút Delete by SignalR Hub
    $('#btnHubDelete').click(function() {
        console.log("🎯 Delete button clicked");

        const dealerId = @Model.DealersHht.ToandealerId;
        console.log("🎯 Dealer ID:", dealerId);

        // Disable button to prevent double-click
        $(this).prop('disabled', true).text('Deleting...');

        // Gọi Hub method
        connection.invoke("DeleteDealerRealtime", dealerId)
            .then(function() {
                console.log("✅ Delete request sent");
                // Wait for result from hub - don't redirect immediately
            })
            .catch(function(err) {
                console.error("❌ Delete request failed:", err);
                alert("Delete request failed: " + err);
                // Re-enable button
                $('#btnHubDelete').prop('disabled', false).text('Delete by SignalRHub');
            });
    });

    // Handle delete result from hub
    connection.on("DeleteResult", function(result) {
        console.log("🎯 DeleteResult received:", result);
        if (result.success) {
            alert("Deleted successfully via SignalR!");
            window.location.href = "/Dealers/Index";
        } else {
            alert("Delete failed: " + (result.message || "Unknown error"));
            // Re-enable button
            $('#btnHubDelete').prop('disabled', false).text('Delete by SignalRHub');
        }
    });
});
</script>